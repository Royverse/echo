# ─── Local development ────────────────────────────────────────────────────────
# Copy this file to `.env.development.local` and drop in your Gemini API key.
# Vite loads *.development.local ONLY in dev mode, so this key is NEVER bundled
# into a production build. In dev, the client calls Google directly with it.
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# ─── Production (Netlify) ─────────────────────────────────────────────────────
# Do NOT set VITE_GEMINI_API_KEY in production — that would expose it in the
# client bundle. Instead set a SERVER-SIDE key the Netlify Functions read:
#
#   netlify env:set GEMINI_API_KEY "your_gemini_api_key_here"
#
# The browser then only ever calls /.netlify/functions/*, and the key stays
# on the server. See netlify/functions/ and src/voice/gemini.js.
